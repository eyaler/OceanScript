    "slot": 2.8000000000000114,
    "duration": 2.35,
    "speaker": "דודה יעל",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-HilaNeural",
      "pitch": -9,
      "rate": 3
    },
    "text": "זה בשביל ה\"סוכנת\".",
