  },
  {
    "t0": 349.18999999999994,
    "slot": 5.149999999999977,
    "duration": 4.7,
    "speaker": "קפטן דודו איל",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-AvriNeural",
      "pitch": -12,
      "rate": -7
    },
    "text": "קרמשניט. ביחד. על שלוש?",
    "spoken": "קְרֶמְשְׁנִיט. בְּיַחַד. עַל שָׁלוֹשׁ?",
