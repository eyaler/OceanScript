    "speaker": "טוראי פישי",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-AvriNeural",
      "pitch": -4,
      "rate": -4
    },
    "text": "סליחה. על העיטוש.",
    "spoken": "סְלִיחָה. עַל הָעִטוּשׁ.",
