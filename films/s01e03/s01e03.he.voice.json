    "duration": 3.17,
    "speaker": "קפטן דודו איל",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-AvriNeural",
      "pitch": -12,
      "rate": -7
    },
    "text": "יעל. לא עז. יעל!",
    "spoken": "יָעֵל. לֹא עַז. יָעֵל!",
    "clip": "out/.tts-cache/328c66e6592635fd.mp3"
  },
  {
    "t0": 332.5899999999999,
    "slot": 4.100000000000023,
    "duration": 3.65,
    "speaker": "דודה יעל",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-HilaNeural",
      "pitch": -9,
      "rate": 3
    },
    "text": "קפטן... נגחת בשבילי?",
    "spoken": "קֶפְּטֶן... נָגַחְתָּ בִּשְׁבִילִי?",
