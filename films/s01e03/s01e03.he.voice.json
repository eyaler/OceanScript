    "voice": {
      "voice": "he-IL-AvriNeural",
      "pitch": -18,
      "rate": -6
    },
    "text": "מרגלים, המפקד! מאחורי הסלע!",
    "spoken": "מְרַגלִים, הַמְפַקֵד! מֵאֲחוֹרֵי הַסֶלַע!",
