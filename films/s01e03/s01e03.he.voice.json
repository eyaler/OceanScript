  },
  {
    "t0": 177.87999999999997,
    "slot": 2.9000000000000057,
    "duration": 2.45,
    "speaker": "כריש",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-AvriNeural",
      "pitch": -18,
      "rate": -6
    },
    "text": "מים לא נושמים.",
    "spoken": "מַיִם לֹא נוֹשׁמִים.",
    "clip": "out/.tts-cache/2a286ea86c5cc7f8.mp3"
  },
  {
    "t0": 180.77999999999997,
    "slot": 5.110000000000014,
    "duration": 4.66,
    "speaker": "דודה יעל",
    "kind": "dialog",
    "voice": {
      "voice": "he-IL-HilaNeural",
      "pitch": -9,
      "rate": 3
    },
    "text": "אם אתה מתעטש עכשיו, טוראי, אני אוכלת אותך בעצמי.",
    "spoken": "אִם אַתָה מִתְעַטֵשׁ עַכשָׁו, טוּרַאי, אֲנִי אוֹכֶלֶת אוֹתְךָ בְּעַצמִי.",
